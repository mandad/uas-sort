<?xml version="1.0" encoding="utf-8"?>
<!-- Ref §9.3 panes: the Review page's splitters (Task U1; replaces the toolkit GridSplitter, which crashed under Native AOT) -->
<UserControl
    x:Class="UasSort.App.Controls.PaneSplitter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True">
    <Grid Background="Transparent">
        <Border x:Name="Grip" Width="4" Height="24" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{ThemeResource ControlStrongFillColorDefaultBrush}" />
    </Grid>
</UserControl>
