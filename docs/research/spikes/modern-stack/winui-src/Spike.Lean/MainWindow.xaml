<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Spike.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="using:Spike.Core"
        xmlns:tv="using:WinUI.TableView"
        xmlns:ctk="using:CommunityToolkit.WinUI.Controls"
        Title="uas-sort spike">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TitleBar x:Name="AppTitleBar" Title="uas-sort" Subtitle="spike" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="320" />
      </Grid.ColumnDefinitions>
      <TreeView x:Name="Tree" ItemsSource="{x:Bind Vm.Groups}">
        <TreeView.ItemTemplate>
          <DataTemplate x:DataType="core:GroupVm">
            <TreeViewItem Content="{x:Bind Title}" />
          </DataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>
      <tv:TableView x:Name="Table" Grid.Column="1" ItemsSource="{x:Bind Vm.Rows}" AutoGenerateColumns="False">
        <tv:TableView.Columns>
          <tv:TableViewTemplateColumn Header="Copy">
            <tv:TableViewTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="core:RowVm">
                <CheckBox IsChecked="{x:Bind Include, Mode=TwoWay}" MinWidth="0" />
              </DataTemplate>
            </tv:TableViewTemplateColumn.CellTemplate>
          </tv:TableViewTemplateColumn>
          <tv:TableViewTemplateColumn Header="Name">
            <tv:TableViewTemplateColumn.CellTemplate>
              <DataTemplate x:DataType="core:RowVm">
                <TextBlock Text="{x:Bind Name}" />
              </DataTemplate>
            </tv:TableViewTemplateColumn.CellTemplate>
          </tv:TableViewTemplateColumn>
          <tv:TableViewNumberColumn Header="MB" Binding="{Binding SizeMb}" />
          <tv:TableViewTextColumn Header="Reason" Binding="{Binding Reason, Mode=TwoWay}" />
        </tv:TableView.Columns>
      </tv:TableView>
      <StackPanel Grid.Column="2" Spacing="8" Padding="12">
        <ctk:Segmented SelectedIndex="0">
          <ctk:SegmentedItem Content="Plan" />
          <ctk:SegmentedItem Content="Review" />
          <ctk:SegmentedItem Content="Commit" />
        </ctk:Segmented>
        <ctk:SettingsCard Header="Radius (mi)" Description="Group videos within this distance">
          <Slider Minimum="5" Maximum="200" Width="140" Value="{x:Bind Vm.RadiusMiles, Mode=TwoWay}" />
        </ctk:SettingsCard>
        <Button Content="Regroup" Command="{x:Bind Vm.RegroupCommand}" />
        <ItemsView x:Name="Thumbs" Height="300" ItemsSource="{x:Bind Vm.Rows}">
          <ItemsView.Layout>
            <LinedFlowLayout LineHeight="60" LineSpacing="4" MinItemSpacing="4" />
          </ItemsView.Layout>
          <ItemsView.ItemTemplate>
            <DataTemplate x:DataType="core:RowVm">
              <ItemContainer>
                <Border Width="96" Height="60" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                  <TextBlock Text="{x:Bind Name}" FontSize="9" TextWrapping="Wrap" />
                </Border>
              </ItemContainer>
            </DataTemplate>
          </ItemsView.ItemTemplate>
        </ItemsView>
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="2" Margin="12,4" Text="{x:Bind Vm.Status, Mode=OneWay}" />
  </Grid>
</Window>
