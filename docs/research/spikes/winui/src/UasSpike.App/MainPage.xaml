<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="UasSpike.App.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12" Padding="12,4">
            <TextBlock Text="Radius R (mi)" VerticalAlignment="Center" />
            <Slider Width="240" Minimum="5" Maximum="150" StepFrequency="5"
                    Value="{x:Bind ViewModel.RadiusMiles, Mode=TwoWay}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" />
        </StackPanel>
        <WebView2 x:Name="MapView" Grid.Row="1" />
    </Grid>
</Page>
